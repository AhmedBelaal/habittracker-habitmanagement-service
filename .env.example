# Standalone npm development with PostgreSQL
PORT=3001
DATABASE_URL=postgresql://habits_service:replace-me@127.0.0.1:5432/habittracker
# Use the database owner or migration role here. The service process uses DATABASE_URL only.
DATABASE_URL_DIRECT=postgresql://replace-owner:replace-me@127.0.0.1:5432/habittracker
INTERNAL_TOKEN=replace-with-the-gateway-internal-token

# Set these when the other services are available on your network.
# SERVICE_B_API=legacy
# SERVICE_B_URL=http://streaks-service:3002
# SERVICE_B_URL=http://service-b:3002
# SERVICE_B_KEY=match-service-b-INTERNAL_API_KEY
# LEGACY_INBOUND_KEY=match-service-b-SERVICE_A_API_KEY
# SERVICE_C_URL=http://time-service:3003
# SERVICE_C_URL=http://service-c:3003

# Docker + Floci reads secrets from Secrets Manager after running infra/setup-aws.sh.
# Optional for external AWS installations managed by your team:
# AWS_REGION=us-east-1
# SERVICE_SECRET_ID=habittracker/habits-service
# CLOUDWATCH_LOG_GROUP=/habits-service
